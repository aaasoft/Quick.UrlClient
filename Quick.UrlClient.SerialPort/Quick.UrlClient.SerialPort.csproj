<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageProjectUrl>https://github.com/aaasoft/Quick.UrlClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aaasoft/Quick.UrlClient</RepositoryUrl>
    <Authors>scbeta</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quick.UrlClient\Quick.UrlClient.csproj" />
  </ItemGroup>

  <Choose>
    <When Condition=" '$(TargetFramework)'=='net6.0' ">
      <ItemGroup>
        <PackageReference Include="System.IO.Ports" Version="6.0.0" />
      </ItemGroup>
    </When>
    <When Condition=" '$(TargetFramework)'=='net8.0' ">
      <ItemGroup>
        <PackageReference Include="System.IO.Ports" Version="8.0.0" />
      </ItemGroup>
    </When>
    <When Condition=" '$(TargetFramework)'=='net10.0' ">
      <ItemGroup>
        <PackageReference Include="System.IO.Ports" Version="10.0.0" />
      </ItemGroup>
    </When>
  </Choose>

</Project>
